{
	"name": "drago-ex/generator",
	"description": "A lightweight CLI tool for generating PHP entity and data class files from your database schema.",
	"type": "library",
	"license": ["MIT"],
	"authors": [
		{
			"name": "Zdeněk Papučík",
			"homepage": "https://github.com/accgit"
		}
	],
	"require": {
		"php": ">=8.3 <9",
		"contributte/console": "^0.10",
		"doctrine/inflector": "^2.0",
		"drago-ex/utils": "^2.0",
		"drago-ex/database": "^3.0",
		"nette/php-generator": "^4.1"
	},
	"require-dev": {
		"nette/bootstrap": "^3.2",
		"nette/tester": "^2.5",
		"tracy/tracy": "^2.10",
		"phpstan/phpstan-nette": "^2"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"Drago\\": "src"
		}
	},
	"bin": ["bin/generator"],
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	}
}
